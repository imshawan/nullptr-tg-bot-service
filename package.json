{
  "name": "nullptr-tg-bot-service",
  "version": "1.0.0",
  "description": "nullptr (NullPointer Bot) - Enterprise TypeScript Telegram Bot Service for LLMs",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imshawan/nullptr-tg-bot-service.git"
  },
  "keywords": [
    "telegram",
    "bot",
    "ollama",
    "llm",
    "oracle-cloud",
    "typescript",
    "enterprise",
    "nullptr"
  ],
  "author": {
    "name": "Shawan Mandal",
    "email": "hello@imshawan.dev",
    "url": "https://imshawan.dev"
  },
  "bugs": {
    "url": "https://github.com/imshawan/nullptr-tg-bot-service/issues"
  },
  "homepage": "https://github.com/imshawan/nullptr-tg-bot-service#readme",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
