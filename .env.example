# Telegram Bot API token from @BotFather
TELEGRAM_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Authorized Telegram user ID(s) who can use nullptr (NullPointer Bot).
# Multiple IDs can be comma-separated: 12345678,87654321
# To find your ID, message @userinfobot or @raw_data_bot on Telegram.
ALLOWED_USER_ID=12345678

# Ollama endpoint deployed on Oracle Cloud (or localhost if running locally)
# Example for remote Oracle Cloud instance: http://123.45.67.89:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Default Ollama model to use with nullptr
OLLAMA_MODEL=qwen2.5-coder:latest

# System prompt defining nullptr's persona and creator identity
SYSTEM_PROMPT="You are nullptr (NullPointer Bot), an expert AI assistant created, authored, and managed by Shawan Mandal (hello@imshawan.dev)."

# Optional: Authorization header if your Ollama instance is behind a reverse proxy (e.g., Bearer token or Basic Auth)
# OLLAMA_AUTH="Bearer your_secret_token"

# Optional: Media Downloader (yt-dlp & ffmpeg) configuration
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# DOWNLOAD_TEMP_DIR=/tmp/nullptr-downloads
# MAX_DOWNLOAD_SIZE_MB=50

# Optional: Outbound proxy (e.g. Cloudflare WARP local proxy on 127.0.0.1:40000)
# YTDLP_PROXY=socks5://127.0.0.1:40000

# Optional: Direct HTTP File Server for large downloads (> 50 MB)
# PORT=3000
# FILE_SERVER_BASE_URL=http://your-server-ip:3000
# DOWNLOAD_LINK_TTL_MINUTES=120
