# Telegram Bot API token from @BotFather
TELEGRAM_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Bot name displayed across messages, UI headers, and logs (default: NullPointer)
# BOT_NAME=NullPointer

# Authorized Telegram user ID(s) or username(s) who can use nullptr (NullPointer Bot).
# Supports 1 or more comma-separated Telegram usernames or numeric IDs: uxyg4nry4,xnhweeh or 12345678,87654321
# Leave empty or comment out to allow unrestricted access.
ALLOWED_USER_IDS=uxyg4nry4,xnhweeh

# Ollama endpoint deployed on Oracle Cloud (or localhost if running locally)
# Example for remote Oracle Cloud instance: http://123.45.67.89:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Default Ollama model to use with nullptr
OLLAMA_MODEL=qwen2.5-coder:latest

# Context window size in tokens allocated by Ollama (default: 2048), The Global Ollama Server Default: 4,096 tokens
# Restricts KV cache memory footprint (saves 3-4 GB RAM on 7B/8B models)
OLLAMA_NUM_CTX=2048

# LLM sampling temperature (default: 0.65)
# Lower values (0.5 - 0.7) prevent hallucinated word salads & emojis in multilingual/slang chat
OLLAMA_TEMPERATURE=0.65

# Enable/disable mature (18+) conversational scope & candid discussion boundaries (default: true)
ALLOW_MATURE_CONTENT=true

# Timezone for temporal situational awareness (default: Asia/Kolkata)
USER_TIMEZONE=Asia/Kolkata

# System prompt defining nullptr's persona and creator identity
SYSTEM_PROMPT="You are NullPointer, an expert AI assistant created, authored, and managed by Shawan Mandal (hello@imshawan.dev)."

# Optional: Authorization header if your Ollama instance is behind a reverse proxy (e.g., Bearer token or Basic Auth)
# OLLAMA_AUTH="Bearer your_secret_token"

# Optional: Media Downloader (yt-dlp & ffmpeg) configuration
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# DOWNLOAD_TEMP_DIR=/tmp/nullptr-downloads
# MAX_DOWNLOAD_SIZE_MB=50

# Optional: Outbound proxy (e.g. Cloudflare WARP local proxy on 127.0.0.1:40000)
# YTDLP_PROXY=socks5://127.0.0.1:40000

# Optional: Direct HTTP File Server for large downloads (> 50 MB)
# PORT=3000
# FILE_SERVER_BASE_URL=http://your-server-ip:3000
# DOWNLOAD_LINK_TTL_MINUTES=120
