[Unit]
Description=nullptr (NullPointer Bot) Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/nullptr-tg-bot-service
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/nullptr-tg-bot-service/.env

[Install]
WantedBy=multi-user.target
